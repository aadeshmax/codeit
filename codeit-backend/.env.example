# Groq Cloud API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Multi-Level Groq Models
GROQ_CLASSIFIER_MODEL=llama-3.1-8b-instant
GROQ_AUDIT_MODEL=openai/gpt-oss-120b
GROQ_MENTOR_MODEL=openai/gpt-oss-20b

# GitHub App Integration
GITHUB_APP_ID=5523137
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_WEBHOOK_URL=https://example.com/api/webhook/github
GITHUB_APP_PRIVATE_KEY_PATH=

# Optional: Fallback Personal Access Token
GITHUB_TOKEN=

# Optional: Cloud Production Checkpointer (PostgreSQL / Supabase)
DATABASE_URL=

