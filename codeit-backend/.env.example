# Groq Cloud API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Multi-Level Groq Models
GROQ_CLASSIFIER_MODEL=llama-3.1-8b-instant
GROQ_AUDIT_MODEL=openai/gpt-oss-120b
GROQ_MENTOR_MODEL=openai/gpt-oss-20b

# GitHub App Integration (Auto-authenticates at 5,000 req/hr)
GITHUB_APP_ID=5523137
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_WEBHOOK_URL=https://codelit-z5gy.onrender.com/api/webhook/github
# Path to .pem file (e.g. github-app-private-key.pem or /etc/secrets/github-app-private-key.pem on Render)
GITHUB_APP_PRIVATE_KEY_PATH=github-app-private-key.pem
# Or paste raw PEM string directly as an environment variable on Render:
GITHUB_APP_PRIVATE_KEY=

# Optional: Fallback Personal Access Token
GITHUB_TOKEN=

# Optional: Cloud Production Checkpointer (PostgreSQL / Supabase)
DATABASE_URL=
